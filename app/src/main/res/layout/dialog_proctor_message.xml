<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="26dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:cardBackgroundColor="@color/robbani_yellow_soft"
        app:cardCornerRadius="32dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="Pesan Pengawas"
            android:src="@drawable/ic_warning"
            app:tint="@color/status_warning" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvProctorModalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Pesan dari Pengawas Ujian"
        android:textColor="@color/text_main"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvProctorModalMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_card"
        android:backgroundTint="@color/bg_light"
        android:gravity="center"
        android:padding="16dp"
        android:text="Harap fokus mengerjakan ujian."
        android:textColor="@color/text_main"
        android:textSize="15.5sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAcknowledgeNotice"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/robbani_accent"
        android:text="Saya Mengerti"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="14dp" />
</LinearLayout>

