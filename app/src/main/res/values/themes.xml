<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.RobbaniExam" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/robbani_accent</item>
        <item name="colorPrimaryVariant">@color/robbani_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/robbani_teal</item>
        <item name="colorSecondaryVariant">@color/robbani_indigo</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/robbani_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.RobbaniExam.Splash" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:statusBarColor">@color/robbani_primary_dark</item>
        <item name="android:windowBackground">@color/robbani_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
